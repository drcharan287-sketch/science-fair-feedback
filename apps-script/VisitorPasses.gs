/**
 * VoiceVote one-time visitor passes (anonymous attendee credentials).
 *
 * IMPORTANT:
 * - Never store plain codes in a Google Sheet or log.
 * - Code entropy is a random UUIDv4 (~122 bits) generated by Apps Script.
 * - Store only SHA-256 of a canonical code in the restricted sheet.
 * - All issuance, redemption and reissue mutations are guarded by ScriptLock.
 * - During preparation, old device-token voting keeps working. Only admins may
 *   activate pass-required mode when passes have been distributed.
 */
const VV_PASS_SHEET = 'Visitor Passes';
const VV_PASS_MODE_PROPERTY = 'VOICEVOTE_REQUIRE_VISITOR_PASSES';
const VV_PASS_HEADERS = [
  'Serial', 'Pass hash (private)', 'Status', 'Issued at', 'Redeemed at',
  'Feedback row', 'Replaces serial', 'Replaced by serial', 'Reason',
  'Code suffix', 'Submission ID'
];
const VV_PASS_FAILURE_LIMIT = 6; // best effort, per anonymous browser token
const VV_PASS_FAILURE_TTL = 900; // seconds

function visitorPassDigest_(value) {
  const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(value));
  return bytes.map(function(byte) {
    return ('0' + ((Number(byte) + 256) % 256).toString(16)).slice(-2);
  }).join('');
}

function visitorPassNormalize_(value) {
  const compact = String(value || '').trim().toUpperCase().replace(/[\s-]/g, '');
  return /^VV[0-9A-F]{32}$/.test(compact) ? compact : '';
}

function visitorPassMode_() {
  return PropertiesService.getScriptProperties()
    .getProperty(VV_PASS_MODE_PROPERTY) === '1' ? 'required' : 'preparation';
}

/** Read-only; no new sheet is created just because a page is viewed. */
function visitorPassSheet_(ss, create) {
  let sheet = ss.getSheetByName(VV_PASS_SHEET);
  if (!sheet && create) {
    sheet = ss.insertSheet(VV_PASS_SHEET);
    sheet.appendRow(VV_PASS_HEADERS);
    if (typeof sheet.setFrozenRows === 'function') sheet.setFrozenRows(1);
    if (typeof sheet.hideColumns === 'function') sheet.hideColumns(2);
  }
  return sheet;
}

function visitorPassRows_(sheet) {
  if (!sheet || sheet.getLastRow() <= 1) return [];
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, VV_PASS_HEADERS.length).getValues();
}

/** Only format codes for immediate admin handoff; never persist plaintext. */
function visitorPassMakeCode_() {
  const entropy = String(Utilities.getUuid()).replace(/-/g, '').toUpperCase();
  if (!/^[A-F0-9]{32}$/.test(entropy)) throw new Error('Unable to generate a valid random pass.');
  return 'VV-' + entropy.match(/.{8}/g).join('-');
}

function visitorPassLock_(action) {
  const lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try { return action(); }
  finally { lock.releaseLock(); }
}

/**
 * Best-effort abuse limiter, not a physical IP/device boundary.
 * Cache may evict data; the random 122-bit pass is the main protection.
 */
function visitorPassRateLimit_(deviceHash, failed) {
  if (typeof CacheService === 'undefined') return false;
  const cache = CacheService.getScriptCache();
  const key = 'vvpassbad:' + String(deviceHash).slice(0, 64);
  const count = Number(cache.get(key) || 0);
  if (!failed) return count >= VV_PASS_FAILURE_LIMIT;
  cache.put(key, String(Math.min(100, count + 1)), VV_PASS_FAILURE_TTL);
  return count + 1 >= VV_PASS_FAILURE_LIMIT;
}

/**
 * Call WITHIN the existing feedback-save ScriptLock.
 * Return a pass row/serial or a legacy voting marker.
 */
function visitorPassValidateForVote_(ss, suppliedCode, deviceHash, feedbackSheet) {
  const required = visitorPassMode_() === 'required';
  const supplied = String(suppliedCode || '').trim();
  if (!supplied && !required) return { legacy: true, serial: '' };
  // Do not reveal whether a code exists, was used or was revoked.
  const generic = 'Visitor pass is invalid, expired, already used or revoked. Ask an organizer for help.';
  if (visitorPassRateLimit_(deviceHash, false)) {
    throw new Error('Too many invalid visitor pass attempts. Contact an organizer.');
  }
  const canonical = visitorPassNormalize_(supplied);
  if (!canonical) {
    visitorPassRateLimit_(deviceHash, true);
    throw new Error(required && !supplied
      ? 'A unique visitor voting pass is required. Ask an organizer.'
      : generic);
  }
  const sheet = visitorPassSheet_(ss, false);
  const digest = visitorPassDigest_(canonical);
  const rows = visitorPassRows_(sheet);
  let entry = null;
  for (let i = 0; i < rows.length; i++) {
    if (String(rows[i][1]) === digest) {
      entry = { sheet: sheet, row: i + 2, serial: String(rows[i][0]),
        status: String(rows[i][2]) };
      break;
    }
  }
  if (!entry || entry.status !== 'AVAILABLE') {
    visitorPassRateLimit_(deviceHash, true);
    throw new Error(generic);
  }
  // Recovery invariant: an append can succeed even if its following pass-sheet
  // update fails. An accepted Feedback row still permanently consumes the pass.
  const count = feedbackSheet.getLastRow() - 1;
  if (count > 0) {
    const accepted = feedbackSheet.getRange(2, 12, count, 1).getValues();
    if (accepted.some(function(row) { return String(row[0]) === entry.serial; })) {
      visitorPassRateLimit_(deviceHash, true);
      throw new Error(generic);
    }
  }
  return entry;
}

/** Call WITHIN the same ScriptLock, immediately after Feedback.appendRow. */
function visitorPassFinalize_(entry, feedbackRow, submissionId) {
  if (!entry || entry.legacy) return;
  entry.sheet.getRange(entry.row, 3).setValue('USED');
  entry.sheet.getRange(entry.row, 5).setValue(new Date());
  entry.sheet.getRange(entry.row, 6).setValue(feedbackRow);
  entry.sheet.getRange(entry.row, 11).setValue(String(submissionId));
}

/** Admin-only, in memory only: gives codes ONCE to be printed/distributed. */
function adminIssueVisitorPasses(key, amount, reason) {
  adminRequireKey_(key);
  const count = Number(amount);
  const why = String(reason || '').trim();
  if (!Number.isInteger(count) || count < 1 || count > 100 ||
      why.length < 8 || why.length > 400) {
    throw new Error('Generate 1–100 passes per batch with an 8–400 character reason.');
  }
  return visitorPassLock_(function() {
    const ss = adminSheet_();
    const sheet = visitorPassSheet_(ss, true);
    const existing = visitorPassRows_(sheet);
    const seen = {};
    existing.forEach(function(r) { seen[String(r[1])] = true; });
    const serialStart = existing.reduce(function(high, r) {
      return Math.max(high, Number(r[0]) || 0);
    }, 0);
    const codes = [];
    const rows = [];
    for (let i = 0; i < count; i++) {
      let code, hash;
      for (let attempt = 0; attempt < 4; attempt++) {
        code = visitorPassMakeCode_();
        hash = visitorPassDigest_(visitorPassNormalize_(code));
        if (!seen[hash]) break;
      }
      if (seen[hash]) throw new Error('Random pass collision; retry.');
      seen[hash] = true;
      const serial = serialStart + i + 1;
      codes.push({ serial: serial, code: code });
      rows.push([serial, hash, 'AVAILABLE', new Date(), '', '', '', '', why,
        code.slice(-4), '']);
    }
    sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, VV_PASS_HEADERS.length)
      .setValues(rows);
    adminLog_(ss, 'ISSUE_VISITOR_PASSES', '', 'Issued ' + count + ' passes: ' + why);
    return { issued: count, codes: codes, warning:
      'Print or copy now. Plaintext visitor codes cannot be retrieved again.' };
  });
}

function adminGetVisitorPasses(key, limit) {
  adminRequireKey_(key);
  const max = Math.max(1, Math.min(150, Math.floor(Number(limit) || 75)));
  const sheet = visitorPassSheet_(adminSheet_(), false);
  const rows = visitorPassRows_(sheet);
  const statusCounts = { AVAILABLE: 0, USED: 0, REVOKED: 0 };
  rows.forEach(function(r) {
    const state = String(r[2]);
    if (Object.prototype.hasOwnProperty.call(statusCounts, state)) statusCounts[state]++;
  });
  return { mode: visitorPassMode_(),
    total: rows.length,
    counts: statusCounts,
    records: rows.slice(-max).reverse().map(function(row) {
      return {serial: Number(row[0]), status: String(row[2]),
        suffix: String(row[9]), replaces: row[6] ? Number(row[6]) : null,
        replacedBy: row[7] ? Number(row[7]) : null};
    })
  };
}

/**
 * Staff exception: revoked LOST/UNUSED pass is replaced by one new pass.
 * A USED pass is never reissued: this must not grant a second accepted vote.
 */
function adminReissueVisitorPass(key, serialNumber, reason) {
  adminRequireKey_(key);
  const serial = Number(serialNumber);
  const why = String(reason || '').trim();
  if (!Number.isInteger(serial) || serial <= 0 ||
      why.length < 8 || why.length > 400) {
    throw new Error('Select a valid pass serial and enter an 8–400 character reason.');
  }
  return visitorPassLock_(function() {
    const ss = adminSheet_();
    const sheet = visitorPassSheet_(ss, false);
    const rows = visitorPassRows_(sheet);
    const index = rows.findIndex(function(r) { return Number(r[0]) === serial; });
    if (index < 0) throw new Error('Pass serial does not exist.');
    if (String(rows[index][2]) !== 'AVAILABLE') {
      throw new Error('Only unused, currently available passes can be reissued.');
    }
    const newSerial = rows.reduce(function(n, r) {
      return Math.max(n, Number(r[0]) || 0);
    }, 0) + 1;
    const code = visitorPassMakeCode_();
    const hash = visitorPassDigest_(visitorPassNormalize_(code));
    if (rows.some(function(r) { return String(r[1]) === hash; })) {
      throw new Error('Random pass collision; retry.');
    }
    // Revoke BEFORE creating the replacement, never temporarily allow both.
    const oldRow = index + 2;
    sheet.getRange(oldRow, 3).setValue('REVOKED');
    sheet.getRange(oldRow, 8).setValue(newSerial);
    sheet.getRange(sheet.getLastRow() + 1, 1, 1, VV_PASS_HEADERS.length)
      .setValues([[newSerial, hash, 'AVAILABLE', new Date(), '', '',
        serial, '', why, code.slice(-4), '']]);
    adminLog_(ss, 'REISSUE_VISITOR_PASS', serial,
      'Replaced with serial ' + newSerial + ': ' + why);
    return {serial: newSerial, replaces: serial, code: code,
      warning: 'Copy or print this replacement code now; it cannot be recovered.'};
  });
}

function adminSetVisitorPassRequired(key, required, reason) {
  adminRequireKey_(key);
  const why = String(reason || '').trim();
  if (typeof required !== 'boolean' || why.length < 8 || why.length > 400) {
    throw new Error('Specify a valid mode and an 8–400 character reason.');
  }
  return visitorPassLock_(function() {
    const ss = adminSheet_();
    if (required) {
      const rows = visitorPassRows_(visitorPassSheet_(ss, false));
      if (!rows.some(function(r) { return String(r[2]) === 'AVAILABLE'; })) {
        throw new Error('Generate and distribute visitor passes before requiring them.');
      }
    }
    PropertiesService.getScriptProperties()
      .setProperty(VV_PASS_MODE_PROPERTY, required ? '1' : '0');
    adminLog_(ss, required ? 'REQUIRE_VISITOR_PASSES' : 'PREPARATION_PASS_MODE',
      '', why);
    return { mode: required ? 'required' : 'preparation' };
  });
}
